<Window x:Class="CALCULATRICE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator"
        Height="770"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0A0A0A">

    <Window.Resources>

        <Style x:Key="NumberButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="28">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#353535"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OperationButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#D99B45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="28">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#E6AD5B"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#F0C47E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearButton" TargetType="Button">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#A5A5A5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="28">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#C5C5C5"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="#0A0A0A">

        <Border Margin="20"
                Padding="18"
                CornerRadius="35"
                Background="#151515"
                BorderBrush="#303030"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="30"
                    ShadowDepth="8"
                    Opacity="0.6"
                    Color="Black"/>
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TITRE -->

                <Grid Grid.Row="0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#252525">

                            <TextBlock Text="+"
                                       Foreground="#D99B45"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="CALCULATRICE"
                                   Foreground="#EEEEEE"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <Ellipse Width="8"
                             Height="8"
                             Fill="#D99B45"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"/>

                </Grid>

                <!-- ECRAN -->

                <Border Grid.Row="1"
                        Margin="0,5,0,15"
                        CornerRadius="25"
                        Background="#0C0C0C"
                        BorderBrush="#282828"
                        BorderThickness="1">

                    <TextBox x:Name="TB_Display"
                             Text="0"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="54"
                             FontWeight="Light"
                             TextAlignment="Right"
                             VerticalContentAlignment="Bottom"
                             Padding="15"
                             Focusable="False"/>

                </Border>

                <!-- BOUTONS -->

                <Grid Grid.Row="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SIN COS TAN -->

                    <Button x:Name="BTN_Sinus"
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="sin"
                            FontSize="20"
                            Click="BTN_Sinus_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Cosinus"
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="cos"
                            FontSize="20"
                            Click="BTN_Cosinus_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Tangente"
                            Grid.Row="0"
                            Grid.Column="2"
                            Content="tan"
                            FontSize="20"
                            Click="BTN_Tangente_Click"
                            Style="{StaticResource NumberButton}"/>

                    <!-- CLEAR -->


                    <Button x:Name="BTN_Clear"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Content="C"
                            Click="BTN_Clear_Click"
                            Style="{StaticResource ClearButton}"/>


                    <!-- DIVISION -->

                    <Button x:Name="BTN_Divide"
                            Grid.Row="1"
                            Grid.Column="3"
                            Content="÷"
                            Click="BTN_Divide_Click"
                            Style="{StaticResource OperationButton}"/>

                    <!-- CHIFFRES 7 8 9 -->

                    <Button x:Name="BTN_Seven"
                            Grid.Row="2"
                            Grid.Column="0"
                            Content="7"
                            Click="BTN_Seven_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Eight"
                            Grid.Row="2"
                            Grid.Column="1"
                            Content="8"
                            Click="BTN_Eight_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Nine"
                            Grid.Row="2"
                            Grid.Column="2"
                            Content="9"
                            Click="BTN_Nine_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Multiply"
                            Grid.Row="2"
                            Grid.Column="3"
                            Content="×"
                            Click="BTN_Multiply_Click"
                            Style="{StaticResource OperationButton}"/>

                    <!-- CHIFFRES 4 5 6 -->

                    <Button x:Name="BTN_Four"
                            Grid.Row="3"
                            Grid.Column="0"
                            Content="4"
                            Click="BTN_Four_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Five"
                            Grid.Row="3"
                            Grid.Column="1"
                            Content="5"
                            Click="BTN_Five_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Six"
                            Grid.Row="3"
                            Grid.Column="2"
                            Content="6"
                            Click="BTN_Six_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Subtract"
                            Grid.Row="3"
                            Grid.Column="3"
                            Content="−"
                            Click="BTN_Subtract_Click"
                            Style="{StaticResource OperationButton}"/>

                    <!-- CHIFFRES 1 2 3 -->

                    <Button x:Name="BTN_One"
                            Grid.Row="4"
                            Grid.Column="0"
                            Content="1"
                            Click="BTN_One_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Two"
                            Grid.Row="4"
                            Grid.Column="1"
                            Content="2"
                            Click="BTN_Two_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Three"
                            Grid.Row="4"
                            Grid.Column="2"
                            Content="3"
                            Click="BTN_Three_Click"
                            Style="{StaticResource NumberButton}"/>

                    <Button x:Name="BTN_Add"
                            Grid.Row="4"
                            Grid.Column="3"
                            Content="+"
                            Click="BTN_Add_Click"
                            Style="{StaticResource OperationButton}"/>

                    <!-- ZERO -->

                    <Button x:Name="BTN_Zero"
                            Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Content="0"
                            Click="BTN_Zero_Click"
                            Style="{StaticResource NumberButton}"/>

                    <!-- EGAL -->

                    <Button x:Name="BTN_Equals"
                            Grid.Row="5"
                            Grid.Column="3"
                            Content="="
                            Click="BTN_Equals_Click"
                            Style="{StaticResource OperationButton}"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>
